# CosBike-App — Environment Variables Example
# Copy this file to `.env` and fill in real values locally.
# NEVER commit the real `.env` file — it is excluded via .gitignore.

# Base URL loaded by the WebView
APP_BASE_URL=https://cosbike.in/

# Add future secrets below (placeholders only — no real values!)
# API_KEY=your_api_key_here
# API_SECRET=your_api_secret_here
